/*
 * -------------------------------------------------
 * Config for cpu_container_smoketest.nf
 * -------------------------------------------------
 * Second TSD smoke test: CPU processes + Apptainer/Singularity
 * containers (no GPU). Reuses the same two profiles the real
 * pipelines combine -- `-profile singularity,tsd` -- so a pass here
 * means the container engine + SLURM/account setup validated by
 * `AUS/tests/TSD_deployability_smoke_test/hello_world.nf` also works
 * with real containers pulling real inputs, before moving on to
 * Somatic and Germline pipelines.
 *
 * This reuses configs/PARABRICKS_TSD.conf (same executor, account,
 * bind mounts, leaf_process/gpu_process labels as the real pipelines)
 * rather than duplicating it -- its --nv container flag is harmless on
 * a CPU-only container. `singularity` reuses configs/singularity.conf,
 * same as somatic.config / germline.config.
 *
 * BEFORE FIRST RUN:
 *   - Copy params.cpu_smoketest.yaml.example to params.yaml and fill in
 *     ref / bams / vcfs / gatk_container / bcftools_container for your
 *     TSD project (see docs/tsd-cpu-container-smoke-test.md).
 *   - Replace pXX in configs/PARABRICKS_TSD.conf with your real TSD
 *     project number, same as for the main pipelines (README.md step 3)
 *     -- this file is shared, so you likely already did this.
 *
 * Run:
 *   nextflow run cpu_container_smoketest.nf -c cpu_container_smoketest.config \
 *     -profile singularity,tsd -params-file params.yaml
 */

manifest {
  name            = 'cpu-container-smoketest-tsd'
  description     = 'TSD deployability smoke test: CPU processes + Apptainer/Singularity containers (gatk CollectWgsMetrics, bcftools stats)'
  mainScript      = 'cpu_container_smoketest.nf'
  nextflowVersion = '>=24.04.0'
}

params {
  ref  = null   // reference FASTA; expects <ref>.fai and a matching .dict alongside (same convention as somatic.config / germline.config)
  bams = null   // glob for recalibrated BAMs, each with a same-name .bai alongside -- e.g. 'bam_recal/*/*.recal.bam'
  vcfs = null   // glob for VCFs to run bcftools stats on -- e.g. 'vcf/**/*.vcf'

  gatk_container     = null   // e.g. file:///cluster/p/pXX/cluster/NGS/images/gatk_4.5.0.0.sif
  bcftools_container = null   // e.g. file:///cluster/p/pXX/cluster/NGS/images/bcftools_1.20.sif

  outdir = 'cpu_container_smoketest_results'
}

// Local record of what actually ran -- same reasoning as hello_world.config:
// useful the first time a real container touches a real file on this
// cluster, to see exit status/duration/work dir per task without
// digging through SLURM logs.
trace {
  enabled   = true
  file      = 'trace_cpu_container_smoketest.txt'
  overwrite = true
}

profiles {
  tsd {
    includeConfig '../../configs/PARABRICKS_TSD.conf'
  }
  singularity {
    includeConfig '../../configs/singularity.conf'
  }
}
