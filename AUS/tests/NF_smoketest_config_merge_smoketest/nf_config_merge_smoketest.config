/*
 * -------------------------------------------------
 * Config for nf_config_merge_smoketest.nf
 * -------------------------------------------------
 * Reuses the REAL cluster identity and resource-sizing files rather than
 * reproducing them, so a pass here is evidence about the actual
 * pipeline configs, not a copy that could drift from them.
 *
 * Deliberately does NOT include the `singularity` profile / engine --
 * these two dummy processes carry no `container` directive and just
 * `echo`, so pulling in the container engine would only add an
 * unrelated variable.
 *
 * BEFORE FIRST RUN:
 *   - Replace pXX in configs/PARABRICKS_TSD.conf with your real TSD
 *     project number (shared file -- you likely already did this for
 *     the main pipelines, see README.md).
 *   - Confirm params.account in configs/PARABRICKS_FOX.conf matches
 *     your Fox project (default 'ec232').
 *
 * Run (from this directory):
 *   nextflow run nf_config_merge_smoketest.nf -c nf_config_merge_smoketest.config -profile tsd,test
 *   nextflow run nf_config_merge_smoketest.nf -c nf_config_merge_smoketest.config -profile tsd,production
 *   nextflow run nf_config_merge_smoketest.nf -c nf_config_merge_smoketest.config -profile fox,test
 *   nextflow run nf_config_merge_smoketest.nf -c nf_config_merge_smoketest.config -profile fox,production
 *   nextflow run nf_config_merge_smoketest.nf -c nf_config_merge_smoketest.config -profile test,tsd   # profile-order check
 *
 * Deliberately-failing check (open decision 3):
 *   nextflow run nf_config_merge_smoketest.nf -c nf_config_merge_smoketest.config -profile tsd
 *
 */

manifest {
  name            = 'nf-config-merge-smoketest'
  description     = 'Verifies fox/tsd cluster configs merge correctly with production/test resource-sizing configs (docs/profile_specification.md, open decision 4)'
  mainScript      = 'nf_config_merge_smoketest.nf'
  nextflowVersion = '>=24.04.0'
}

trace {
  enabled   = true
  file      = 'trace_nf_config_merge_smoketest.txt'
  overwrite = true
}

profiles {
  tsd {
    includeConfig '../../configs/PARABRICKS_TSD.conf'
  }
  fox {
    includeConfig '../../configs/PARABRICKS_FOX.conf'
  }
  production {
    includeConfig '../../configs/resources_production.conf'
  }
  test {
    includeConfig '../../configs/resources_test.conf'
  }
}
