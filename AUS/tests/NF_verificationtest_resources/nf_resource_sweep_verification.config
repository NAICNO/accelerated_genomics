/*
 * -------------------------------------------------
 * Config for nf_resource_sweep_verification.nf
 * -------------------------------------------------
 * Reuses cluster and resource-sizing files, so a pass here is evidence
 * about the actual pipeline configs, not a copy that could drift from
 * them. Deliberately does NOT include the `singularity` profile / engine
 * Dummy processes in this test carry no `container` directive and just
 * `echo`, same reasoning as nf_config_merge_smoketest.config.
 *
 * BEFORE FIRST RUN:
 *   - Replace pXX in configs/PARABRICKS_TSD.conf with your real TSD
 *     project number (shared file -- you likely already did this).
 *   - Confirm params.account in configs/PARABRICKS_FOX.conf matches
 *     your Fox project.
 *
 * Run (from this directory), once per combo:
 *   nextflow run nf_resource_sweep_verification.nf -c nf_resource_sweep_verification.config -profile tsd,production
 *   nextflow run nf_resource_sweep_verification.nf -c nf_resource_sweep_verification.config -profile tsd,test
 *   nextflow run nf_resource_sweep_verification.nf -c nf_resource_sweep_verification.config -profile fox,production
 *   nextflow run nf_resource_sweep_verification.nf -c nf_resource_sweep_verification.config -profile fox,test
 *
 * See README.md for the full release-verification
 * workflow (renaming output TSVs, diffing against golden references).
 */

manifest {
  name            = 'nf-resource-sweep-verification'
  description     = 'Release-verification test: every real process name/label against the real resource-sizing configs, written to one TSV per cluster/profile combo'
  mainScript      = 'nf_resource_sweep_verification.nf'
  nextflowVersion = '>=24.04.0'
}

trace {
  enabled   = true
  file      = 'trace_nf_resource_sweep_verification.txt'
  overwrite = true
}

profiles {
  tsd {
    includeConfig '../../configs/PARABRICKS_TSD.conf'
  }
  fox {
    includeConfig '../../configs/PARABRICKS_FOX.conf'
  }
  production {
    includeConfig '../../configs/resources_production.conf'
  }
  test {
    includeConfig '../../configs/resources_test.conf'
  }
}
