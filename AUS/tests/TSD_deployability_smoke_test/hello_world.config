/*
 * -------------------------------------------------
 * Nextflow config for hello_world.nf
 * -------------------------------------------------
 * Deliberately minimal: only what's needed to route the single
 * SAY_HELLO process through SLURM on TSD, so a successful run tells you
 * "Nextflow + SLURM + your account work on TSD", nothing more.
 *
 * No `singularity` scope here on purpose -- SAY_HELLO is plain shell
 * (`echo`), so there's no container to pull/bind and no need to combine
 * with configs/singularity.conf the way somatic.config / germline.config
 * do. That keeps this test decoupled from Apptainer/Singularity being
 * set up correctly, which is exactly what you want to isolate first.
 *
 * BEFORE FIRST RUN:
 *   - Replace pXX below with your real TSD project's SLURM account
 *     (same placeholder convention as configs/PARABRICKS_TSD.conf /
 *     configs/TSD.config).
 *   - Confirm Nextflow is available on the TSD submit node
 *
 * Run:
 *   nextflow run hello_world.nf -c hello_world.config -profile tsd     # on TSD, via SLURM
 */

// Keep a local record of what actually ran -- useful the first time on
// a new cluster, to see wall time / exit status / working dir per task
// without digging through SLURM's own logs.
trace {
  enabled   = true
  file      = 'trace_hello_world.txt'
  overwrite = true
}

profiles {
  tsd {
    process {
      executor = 'slurm'

      // On TSD, specify --mem-per-cpu, not --mem:
      // https://www.uio.no/english/services/it/research/sensitive-data/use-tsd/hpc/job-scripts.html
      clusterOptions = '--account=pXX --mem-per-cpu=1000M'

      cpus = 1
      time = 5.m

      errorStrategy = 'retry'
      maxRetries    = 1
    }
  }

}
