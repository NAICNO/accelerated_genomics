/*
 * -------------------------------------------------
 * Config for nf_ext_multikey_smoketest.nf
 * -------------------------------------------------
 * Three withName blocks, each a two-key ext map-literal. Z's threads
 * value (32) is deliberately larger than its own mem_gb and larger than
 * either other process's threads, so a mem_gb<->threads mix-up WITHIN a
 * single process's own map -- not just a leak from another process --
 * would also be visible.
 *
 * No includeConfig of any real cluster/resource file.
 *
 * Run (from this directory):
 *   nextflow run nf_ext_multikey_smoketest.nf -c nf_ext_multikey_smoketest.config
 *
 * See nf-ext-multikey-smoke-test.md for the full checklist.
 */

manifest {
  name            = 'nf-ext-multikey-smoketest'
  description     = 'Multi-key ext map-literal test (docs/map-literal_selector_scoping_specs.md, Test 3 / open question 3)'
  mainScript      = 'nf_ext_multikey_smoketest.nf'
  nextflowVersion = '>=24.04.0'
}

trace {
  enabled   = true
  file      = 'trace_nf_ext_multikey_smoketest.txt'
  overwrite = true
}

process {
    executor = 'local'

    withName:X { ext = [ mem_gb: 64, threads: 8  ] }
    withName:Y { ext = [ mem_gb: 16, threads: 4  ] }
    withName:Z { ext = [ mem_gb: 8,  threads: 32 ] }
}
