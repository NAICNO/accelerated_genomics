/*
 * Germline param defaults for nf_giraffe_arg_smoketest.nf -- mirrors what
 * germline.config's params {} block will gain:
 * germline_mapping defaults to the proven 'fq2bam' path, graph_*
 * default to null. Pass with -c for every `--entrypoint germline` run; leave
 * it off for `--entrypoint somatic` (somatic.config has no germline_mapping).
 */
params {
  germline_mapping = 'fq2bam'   // 'fq2bam' | 'giraffe'
  graph_gbz        = null
  graph_dist       = null
  graph_min        = null
  graph_zipcodes   = null
  graph_ref_paths  = null
}
