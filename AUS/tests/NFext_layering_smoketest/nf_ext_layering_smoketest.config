/*
 * -------------------------------------------------
 * Config for nf_ext_layering_smoketest.nf
 * -------------------------------------------------
 * withLabel:has_default sets TWO ext keys; the more-specific
 * withName:LAYERED block sets only ONE of them, with a different value,
 * so the two possible merge outcomes are distinguishable by inspection:
 *
 *   - overwrite semantics:     LAYERED's task.ext == [mem_gb: 64]
 *                              (no `threads` key at all)
 *   - shallow-merge semantics: LAYERED's task.ext == [mem_gb: 64, threads: 2]
 *
 * No includeConfig of any real cluster/resource file -- this is purely
 * about Nextflow's own directive-merge mechanism.
 *
 * Run (from this directory):
 *   nextflow run nf_ext_layering_smoketest.nf -c nf_ext_layering_smoketest.config
 *
 * See nf-ext-layering-smoke-test.md for the full checklist.
 */

manifest {
  name            = 'nf-ext-layering-smoketest'
  description     = 'Selector-layering test: withLabel default ext vs more-specific withName ext (docs/map-literal_selector_scoping_specs.md, Test 2 / open question 2)'
  mainScript      = 'nf_ext_layering_smoketest.nf'
  nextflowVersion = '>=24.04.0'
}

trace {
  enabled   = true
  file      = 'trace_nf_ext_layering_smoketest.txt'
  overwrite = true
}

process {
    executor = 'local'

    withLabel:has_default {
        ext = [ mem_gb: 8, threads: 2 ]
    }

    withName:LAYERED {
        ext = [ mem_gb: 64 ]
        // Deliberately omits `threads` -- see header comment above for
        // what each possible outcome would mean.
    }
}
