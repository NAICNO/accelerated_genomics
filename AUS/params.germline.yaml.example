# Example -params-file for germline_workflow.nf.
#
# Copy this file (e.g. to params.yaml, or one file per sample), fill in real
# paths, and run:
#
#   nextflow run germline_workflow.nf -c germline.config -profile singularity,tsd \
#     -params-file params.yaml
#
# Anything set here can still be overridden on the command line, e.g.
# `--emit_gvcf true` -- CLI flags take precedence over this file.
#
# containers below are per-cluster infrastructure, not per-sample -- see
# README/germline.config before overriding them here; most runs shouldn't
# need to.

# ---- input: single sample FASTQ pair (all required) ----
sample_id: SAMPLE01
fastq_1:   /path/S_R1.fastq.gz
fastq_2:   /path/S_R2.fastq.gz

# ---- reference & resources ----
ref: /path/reference.fa   # reference FASTA; expects <ref>.fai and a matching .dict alongside
# ---- aligner + reference ----
# germline_mapping picks the aligner: fq2bam (default) or giraffe. The meaning of
# `ref` depends on it -- see docs/Giraffe_implementation_specs_dev.md section 5g.
#
# fq2bam branch (default; germline_mapping may be omitted):
germline_mapping: fq2bam
ref: /path/reference.fa   # standard linear reference (e.g. GRCh38); .fai/.dict and
                          # BWA index files alongside

# giraffe branch -- comment out the two lines above and uncomment these.
# `ref` MUST come from the SAME graph as graph_gbz (vg paths -F, restricted to the
# graph_ref_paths contigs in the same order) -- NOT an independently chosen GRCh38
# FASTA, even though it is the same `ref` key. A mismatch is not detected by the
# pipeline. Example paths: the Parabricks-test GRCh38 bundle used for Tier 1/2
# (docs/Giraffe_tier2_context.md section 3).
# germline_mapping: giraffe
# ref:             /path/refdata/Homo_sapiens_assembly38.primary.gbz.fa
# graph_gbz:       /path/refdata/Homo_sapiens_assembly38.autoindex.1.70.giraffe.gbz
# graph_dist:      /path/refdata/Homo_sapiens_assembly38.autoindex.1.70.dist
# graph_min:       /path/refdata/Homo_sapiens_assembly38.autoindex.1.70.shortread.withzip.min
# graph_zipcodes:  /path/refdata/Homo_sapiens_assembly38.autoindex.1.70.shortread.zipcodes
# graph_ref_paths: /path/refdata/Homo_sapiens_assembly38.primary.paths   # chr1..22,X,Y in order

# known-sites VCFs for BQSR (dbSNP, Mills, etc.), each needs a .tbi alongside.
# A YAML list works here (unlike the CLI, which only accepts a comma-separated
# string for --known_sites).
known_sites:
  - /path/dbsnp.vcf.gz
  - /path/mills.vcf.gz

# ---- optional ----
deepvariant_mode: shortread   # shortread | pacbio | ont (pbrun v4.7.1)
emit_gvcf: false              # set true to have haplotypecaller emit a GVCF instead of a regular VCF

# exome (WES) support -- uncomment both to restrict analysis to target regions;
# interval_file must be BED. 
# sequencing_type: wes
# interval_file: /path/targets.bed

outdir: results

# ---- containers (Apptainer/Singularity .sif paths or image URIs) ----
# singularity_profile_design notes: these stay explicit params, not baked
# into configs/singularity.conf, so they can be overridden without a repo edit.
parabricks_container: file:///cluster/p/pXX/cluster/NGS/images/clara-parabricks_<version>.sif
bcftools_container:   file:///cluster/p/pXX/cluster/NGS/images/bcftools_1.20.sif
