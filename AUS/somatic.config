/*
 * -------------------------------------------------
 * Somatic workflow config
 * -------------------------------------------------
 * GPU-accelerated somatic variant calling with NVIDIA Clara Parabricks:
 * fq2bam -> bqsr -> applybqsr -> {mutectcaller -> {postpon, vcfqc}, deepsomatic}
 *
 * Executor/cluster specifics live in configs/PARABRICKS_TSD.conf and are
 * pulled in via the `tsd` profile below. That file is shared infrastructure
 * (Slurm/Apptainer/GPU settings) -- not renamed for the somatic workflow,
 * since the planned germline workflow will reuse it too.
 *
 * Because this file isn't named "nextflow.config", it won't be auto-loaded;
 * pass it explicitly with -c. Example run on TSD/Colossus:
 *
 *   nextflow run somatic_main.nf -c somatic.config -profile tsd \
 *     --tumor_id  TUMOR01  --tumor_fastq_1  /path/T_R1.fastq.gz  --tumor_fastq_2  /path/T_R2.fastq.gz \
 *     --normal_id NORMAL01 --normal_fastq_1 /path/N_R1.fastq.gz --normal_fastq_2 /path/N_R2.fastq.gz \
 *     --ref /path/reference.fa \
 *     --known_sites /path/dbsnp.vcf.gz,/path/mills.vcf.gz \
 *     --germline_resource /path/gnomad.vcf.gz \
 *     --pon /path/panel_of_normals.vcf.gz \
 *     --parabricks_container file:///cluster/p/pXX/cluster/NGS/images/clara-parabricks_4.4.0-1.sif \
 *     --gatk_container       file:///cluster/p/pXX/cluster/NGS/images/gatk_4.5.0.0.sif \
 *     --bcftools_container   file:///cluster/p/pXX/cluster/NGS/images/bcftools_1.20.sif
 */

manifest {
  name            = 'parabricks-somatic-tsd'
  description     = 'GPU-accelerated somatic variant calling (Mutect2 + DeepSomatic) with Clara Parabricks on TSD/Colossus'
  mainScript      = 'somatic_main.nf'
  nextflowVersion = '>=24.04.0'
}

params {
  // ---- input: single tumor/normal FASTQ pair ----
  tumor_id       = null
  tumor_fastq_1  = null
  tumor_fastq_2  = null
  normal_id      = null
  normal_fastq_1 = null
  normal_fastq_2 = null

  // ---- reference & resources ----
  ref                     = null   // reference FASTA; expects <ref>.fai and a matching .dict alongside
  known_sites             = null   // comma-separated known-sites VCFs for BQSR (dbSNP, Mills, etc.), each with a .tbi alongside
  germline_resource       = null   // gnomAD-style resource for GetPileupSummaries / CalculateContamination, with a .tbi alongside
  pon                     = null   // optional Mutect2 panel-of-normals VCF (bgzipped + .tbi); leave unset to skip
  deepsomatic_model_type  = 'WGS'  // WGS | WES | PACBIO | ONT -- confirm current options against `pbrun deepsomatic --help`

  // ---- containers (Apptainer/Singularity .sif paths or image URIs) ----
  parabricks_container = null
  gatk_container        = null
  bcftools_container    = null

  outdir = 'results'
}

profiles {
  tsd {
    includeConfig 'configs/PARABRICKS_TSD.conf'
  }
  fox {
    includeConfig 'configs/PARABRICKS_FOX.conf'
  }
}
